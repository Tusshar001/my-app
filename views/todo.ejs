<!DOCTYPE html>
<html>
<head>
    <title>Jenkins CI/CD with GitHub Integration</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 40px;
        }

        a {
            text-decoration: none;
            color: black;
            margin-right: 8px;
        }

        ul {
            padding: 0;
        }

        li {
            list-style: none;
            margin: 8px 0;
            padding: 8px;
            background: #f4f4f4;
            border-radius: 5px;
        }

        form {
            margin-top: 20px;
        }

        input[type="text"] {
            padding: 8px;
            width: 250px;
        }

        input[type="submit"] {
            padding: 8px 12px;
            cursor: pointer;
        }
    </style>
</head>

<body>

    <h1>
        Tusshar has finally automated the CI/CD pipeline using Jenkins 
    </h1>

    <ul>
        <% todolist.forEach(function(todo, index) { %>
            <li>
                <a href="/todo/delete/<%= index %>">✘</a>
                <a href="/todo/<%= index %>">✎</a>
                <%= todo %>
            </li>
        <% }); %>
    </ul>

    <form action="/todo/add" method="post">
        <label for="newtodo">What should I do?</label><br><br>
        <input type="text" name="newtodo" id="newtodo" autofocus required />
        <input type="submit" value="Add" />
    </form>

</body>
</html>
